{
	"schemaVersion": 1,
	"id": "stunslam",
	"version": "${version}",
	"name": "Stun Slam",
	"description": "A simple mod that detects stun slams performed and shows short animation on success!",
	"authors": [
		"CoresCode"
	],
	"contact": {
		"homepage": "https://github.com/CoresCode/StunSlam",
		"sources": "https://github.com/CoresCode/StunSlam",
		"issues": "https://github.com/CoresCode/StunSlam/issues"
	},
	"license": "MIT",
	"icon": "assets/stunslam/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.corescode.stunslam.client.StunSlamClient"
		],
		"modmenu": [
			"com.corescode.stunslam.client.StunSlamModMenu"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}
